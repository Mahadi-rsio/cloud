# Database
DATABASE_URL=postgresql://user:password@host:5432/db

# Auth
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_DOMAIN=fly.dev

# Fly.io deployment
FLY_API_TOKEN=
FLY_ORG_SLUG=
FLY_DEFAULT_REGION=sin
FLY_DEFAULT_IMAGE=nginx:alpine

# Builder (control plane -> shared builder machine)
BUILDER_URL=
BUILDER_API_TOKEN=
BUILDER_APP_NAME=
BUILDER_MACHINE_ID=

# Builder machine -> control plane callbacks
INTERNAL_API_TOKEN=
CONTROL_PLANE_URL=

# OCI registry the builder pushes images to
OCI_REGISTRY=
OCI_REGISTRY_USERNAME=
OCI_REGISTRY_PASSWORD=

# Build tuning
BUILD_IDLE_TIMEOUT_MS=600000
BUILD_MAX_ATTEMPTS=3
BUILD_WORKSPACE_DIR=
BUILD_DEFAULT_INTERNAL_PORT=8080

# Optional GitHub token (raises rate limits; never required for public repos)
GITHUB_API_TOKEN=

# Upstash Redis (session/cache storage + rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare preview builds (true when building a preview deployment)
CLOUDFLARE_PREVIEW_BUILD=false

# --- Builder machine (builder/server.mjs) only ---
PORT=8080
# Path to the railpack CLI (installed in the builder image; point at a local binary for dev)
RAILPACK_BIN=railpack
BUILDKIT_HOST=
RAILPACK_FRONTEND_IMAGE=ghcr.io/railwayapp/railpack-frontend
GITHUB_TOKEN=
BUILD_MAX_DURATION_MS=1500000
# auto: use the repo Dockerfile when present, else Railpack (falls back to Railpack if the Dockerfile build fails)
# railpack: always use Railpack; dockerfile: require a Dockerfile and never fall back
BUILD_STRATEGY=auto