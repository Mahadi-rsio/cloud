# ==============================================================================
# libSQL (sqld) Multi-Tenant Database Service Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration (Set in fly.toml [env] or docker-compose.yml)
# ------------------------------------------------------------------------------
# Node topology role: "primary" for the primary write leader, or "replica" for read replicas.
SQLD_NODE=primary

# IP and port where the user query engine (HTTP & Hrana WebSocket API) listens.
SQLD_HTTP_LISTEN_ADDR=0.0.0.0:8080

# IP and port where the administrative management API listens.
SQLD_ADMIN_LISTEN_ADDR=0.0.0.0:8082

# Filesystem path for SQLite databases, WAL logs, and namespace metastore catalog.
SQLD_DB_PATH=/var/lib/sqld/data.sqld

# Maximum number of database handles kept resident in memory. Inactive databases are paged out.
SQLD_MAX_ACTIVE_NAMESPACES=100

# Maximum size permitted for a single query response.
SQLD_MAX_RESPONSE_SIZE=10MB

# Maximum cumulative response size permitted across a batched pipeline query.
SQLD_MAX_TOTAL_RESPONSE_SIZE=32MB

# (Optional) Disable the "default" database fallback, strictly requiring an identified namespace.
# SQLD_DISABLE_DEFAULT_NAMESPACE=true

# ------------------------------------------------------------------------------
# 2. Server Secrets (Set via `fly secrets set` - NEVER commit raw keys to git)
# ------------------------------------------------------------------------------
# Secret key protecting the Admin API on port 8443 / 8082. Passed via "Authorization: Basic <key>".
LIBSQL_ADMIN_AUTH_KEY=your_64_character_hex_or_alphanumeric_admin_key_here

# Server-wide Ed25519 public key (PEM string) for validating tenant JWT tokens on the Data plane.
# SQLD_AUTH_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...-----END PUBLIC KEY-----\n"

# ------------------------------------------------------------------------------
# 3. External Next.js App / Platform Control Plane (.env.local / .dev.vars)
# ------------------------------------------------------------------------------
# Protected Admin API URL used by the control plane to create, fork, and delete databases.
LIBSQL_ADMIN_URL=https://libsql-database-service.fly.dev:8443

# Public Data Plane URL used by client SDKs and tenant applications to execute queries.
LIBSQL_DATA_URL=https://libsql-database-service.fly.dev
# After DNS propagates, tenants connect via: https://{namespace}.cloudisy.top

# Base domain for wildcard tenant subdomain routing (e.g. <namespace>.db.yourplatform.com).
LIBSQL_BASE_DOMAIN=cloudisy.top
# Tenant URL pattern: {namespace}.cloudisy.top

# ------------------------------------------------------------------------------
# 4. Metastore & WAL S3 Backup Configuration (Optional Bottomless Replication)
# ------------------------------------------------------------------------------
# Enable automated metastore replication to S3-compatible storage.
# SQLD_BACKUP_META_STORE=true
# SQLD_META_STORE_BUCKET_NAME=my-sqld-backups
# SQLD_META_STORE_BUCKET_ENDPOINT=https://fly.storage.tigris.dev
# SQLD_META_STORE_ACCESS_KEY_ID=your_access_key
# SQLD_META_STORE_SECRET_ACCESS=your_secret_key
# SQLD_META_STORE_REGION=auto
# SQLD_META_STORE_BACKUP_ID=primary-cluster
